# Copy to .env and fill in. .env overrides any key exported in your shell.
GEMINI_API_KEY=
# Main model for perception, critique and prediction.
GEMINI_MODEL=gemini-4-argon
# Optional cheaper model (not used by default).
GEMINI_FAST_MODEL=
# Optional: video sampling fps sent to Gemini (0 = API default).
RC_VIDEO_FPS=0
